# Cadena de conexión de PostgreSQL con un usuario que pertenezca a los tres roles de la BD
DATABASE_URL=host=localhost port=5432 dbname=sistema_experto user=app_se password=CAMBIAR
# Clave de firma de sesiones (cadena larga y aleatoria)
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
# 1 cuando se sirva por HTTPS (cookies con atributo Secure)
COOKIE_SEGURA=0
